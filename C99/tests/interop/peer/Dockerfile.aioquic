# The keylog peer (WT-135): aioquic, a self-signed certificate, and an NSS keylog.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir aioquic==1.3.0
WORKDIR /srv
COPY aioquic_peer.py /srv/aioquic_peer.py
# A self-signed certificate for "localhost", generated at build time.
RUN mkdir -p /srv/certs && openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
      -keyout /srv/certs/key.pem -out /srv/certs/cert.pem -days 2 -subj "/CN=localhost" >/dev/null 2>&1
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "/srv/aioquic_peer.py"]
